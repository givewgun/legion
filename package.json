{
  "name": "legion",
  "version": "0.0.0",
  "description": "Legion — distributed multi-agent stock signal gestalt",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "db:migrate": "node src/db/migrate.js",
    "agent:technical": "node src/run/agent-technical.js",
    "agent:news": "node src/run/agent-news.js",
    "agent:social": "node src/run/agent-social.js",
    "agent:contrarian": "node src/run/agent-contrarian.js",
    "risk": "node src/run/risk.js",
    "scheduler": "node src/run/scheduler.js",
    "emitter": "node src/run/emitter.js",
    "kick": "node src/run/orchestrator.js",
    "api": "node src/run/api.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "nats": "^2.28.0",
    "node-cron": "^3.0.3",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
