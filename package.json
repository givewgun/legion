{
  "name": "legion",
  "version": "0.0.0",
  "description": "Legion — distributed multi-agent stock signal gestalt",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "db:migrate": "node src/db/migrate.js",
    "agent:technical": "node src/run/agent-technical.js",
    "agent:news": "node src/run/agent-news.js",
    "agent:social": "node src/run/agent-social.js",
    "agent:contrarian": "node src/run/agent-contrarian.js",
    "risk": "node src/run/risk.js",
    "scheduler": "node src/run/scheduler.js",
    "emitter": "node src/run/emitter.js",
    "kick": "node src/run/orchestrator.js",
    "api": "node src/run/api.js",
    "reliability": "node src/run/reliability.js",
    "summary": "node src/run/summary.js",
    "backtest": "node src/run/backtest.js",
    "retrigger": "node scripts/retrigger.js"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.55.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.57.0",
    "@opentelemetry/sdk-node": "^0.57.0",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.19.0",
    "google-auth-library": "^10.7.0",
    "nats": "^2.28.0",
    "node-cron": "^3.0.3",
    "ollama": "^0.6.3",
    "p-retry": "^6.2.1",
    "pg": "^8.20.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
