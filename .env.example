# GunVest API (data source)
GUNVEST_API_URL=http://localhost:3001

# Contrarian feeds (net-new, optional). FINNHUB_API_KEY drives short interest;
# copy the value from GunVest's .env. CBOE/AAII/NAAIM degrade to null if no source.
FINNHUB_API_KEY=

# PostgreSQL (shared with GunVest, legion schema)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gunvest

# NATS
NATS_URL=nats://localhost:4222

# Local LLM (Ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# Ollama provider (app side)
# OLLAMA_THINK: leave unset/blank for non-thinking models (qwen2.5) — the
# `think` field is then omitted entirely. Set false/true only for a qwen3
# thinking model whose tag actually honors it (qwen3:4b on ollama 0.30.6 did
# not — it kept reasoning regardless, too slow on CPU).
OLLAMA_THINK=
OLLAMA_TIMEOUT_MS=300000      # per-request inference deadline (ms)
OLLAMA_MAX_CONCURRENT=1       # in-flight inferences per agent process
# Ollama server (set on the ollama container) — run inference strictly serial
OLLAMA_NUM_PARALLEL=1         # one inference at a time (full cores each = fastest per request)
OLLAMA_KEEP_ALIVE=30m         # warm for a whole sweep, unloads between cycles (-1 leaks runner memory)

# Home PC model server — the PC-preferred `local` primary. Unset HOME_OLLAMA_URL =
# feature off (pure Oracle). When the PC is available Legion COMMITS to it and queues
# (no load-failover to Oracle); Oracle serves only when the PC is asleep/busy/off. The
# PC's parallelism is set PC-side by pc-host/setup.ps1 (OLLAMA_NUM_PARALLEL=2 on the
# GPU), NOT here — the OLLAMA_NUM_PARALLEL line above is the Oracle CPU box.
HOME_OLLAMA_URL=             # e.g. http://<pc-tailscale-ip>:11435  (sidecar-fronted)
HOME_MODEL=qwen3:14b         # capable reasoning model; ~9 GB, fits 2 parallel slots on a 16 GB card
HOME_THINK=true              # qwen3 reasons; <think> tokens are stripped before parsing
HOME_PROBE_TIMEOUT_MS=1500   # readiness probe deadline — fail fast to Oracle when the PC is asleep
HOME_TIMEOUT_MS=3600000      # per-call PC deadline (60 min) — outlasts a deep queue instead of aborting
HOME_FALLBACK=false          # false = PIN the PC (never spill to Oracle); true/unset = tiered Oracle fallback

# Hosted model families (optional). Assign per-agent on the dashboard Agents tab;
# mixing families across agents is the strongest form of panel diversity.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible server works
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Consensus tuning
CONSENSUS_THETA_V=0.75
CONSENSUS_QUORUM=0.6667
CONSENSUS_MAX_ROUNDS=3
CONSENSUS_HOLD_BAND=0.5

# Telegram (reuse GunVest's bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Emitter: voting agents to wait for, and whether the risk constraint is required
LEGION_EXPECTED_AGENTS=4
LEGION_RISK_ENABLED=true

# Scheduler cron, evaluated in LEGION_CRON_TZ — NOT the container TZ (prod runs
# Asia/Bangkok). Default: twice per US trading day — 11:00 ET mid-session,
# 17:00 ET post-close. Agents read daily candles, so more frequent fires
# re-evaluate the same bar (ADR 0029).
LEGION_CRON=0 11,17 * * 1-5
LEGION_CRON_TZ=America/New_York

# Meta-reflection (ADR 0026): distill each agent's recent misses into a lesson
# on the reliability cron (puts an LLM in the cron; off by default)
LEGION_REFLECTION=false
