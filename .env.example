# GunVest API (data source)
GUNVEST_API_URL=http://localhost:3001

# Contrarian feeds (net-new, optional). FINNHUB_API_KEY drives short interest;
# copy the value from GunVest's .env. CBOE/AAII/NAAIM degrade to null if no source.
FINNHUB_API_KEY=

# PostgreSQL (shared with GunVest, legion schema)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gunvest

# NATS
NATS_URL=nats://localhost:4222

# Local LLM (Ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# Ollama provider (app side)
OLLAMA_TIMEOUT_MS=300000      # per-request inference deadline (ms)
OLLAMA_MAX_CONCURRENT=1       # in-flight inferences per agent process
# Ollama server (set on the ollama container) — run inference strictly serial
OLLAMA_NUM_PARALLEL=1         # one inference at a time (full cores each = fastest per request)
OLLAMA_KEEP_ALIVE=-1          # keep model resident (no ~5GB reload between calls)

# Consensus tuning
CONSENSUS_THETA_V=0.5
CONSENSUS_QUORUM=0.6667
CONSENSUS_MAX_ROUNDS=3
CONSENSUS_HOLD_BAND=0.5

# Telegram (reuse GunVest's bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Emitter: voting agents to wait for, and whether the risk constraint is required
LEGION_EXPECTED_AGENTS=4
LEGION_RISK_ENABLED=true

# Scheduler cron (default every 4h)
LEGION_CRON=0 */4 * * *
